---
import { EXPERIENCES } from '../data/experience.js';
---

<section id="journey" class="journey-section">
  <div class="container">
    <div class="grid-2">
      <div class="journey-sidebar">
        <span class="section-tag">Trajectory</span>
        <h2>Academic & Professional Path</h2>
        <p class="lead">A timeline of university coursework, hands-on internships, and ongoing client freelance projects.</p>

        <div class="timeline-summary-card">
          <div class="summary-metric">
            <span class="metric-number">3+</span>
            <span class="metric-label">Years of Computer Science Studies</span>
          </div>
          <div class="summary-metric">
            <span class="metric-number">100+</span>
            <span class="metric-label">Client Graphic Deliverables</span>
          </div>
        </div>
      </div>

      <div class="journey-timeline">
        <ol class="timeline-list">
          {EXPERIENCES.map((exp) => (
            <li class="timeline-item">
              <div class="timeline-marker" aria-hidden="true"></div>
              <div class="timeline-content">
                <div class="timeline-meta">
                  <span class="timeline-period">{exp.period}</span>
                  <span class="timeline-type">{exp.type}</span>
                </div>
                <h3 class="timeline-role">{exp.role}</h3>
                <h4 class="timeline-org">{exp.organization} &bull; <span class="timeline-loc">{exp.location}</span></h4>
                <p class="timeline-desc">{exp.description}</p>
                {exp.highlights && (
                  <ul class="timeline-highlights">
                    {exp.highlights.map(h => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .journey-section {
    border-top: 1px solid var(--line-subtle);
  }

  .timeline-summary-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .summary-metric {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .metric-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent);
  }

  .metric-label {
    font-size: 0.9rem;
    color: var(--mute);
    font-weight: 500;
  }

  .timeline-list {
    list-style: none;
    position: relative;
    padding-left: 2rem;
    border-left: 2px solid var(--line);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 3rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-2rem - 6px);
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: 0 0 10px var(--accent-glow);
    transition: transform var(--duration-fast);
  }

  .timeline-item:hover .timeline-marker {
    transform: scale(1.3);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
  }

  .timeline-type {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    background: var(--soft);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    color: var(--ink);
  }

  .timeline-role {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .timeline-org {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-secondary);
    margin-bottom: 0.85rem;
  }

  .timeline-loc {
    font-weight: 400;
    color: var(--mute);
  }

  .timeline-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--mute);
    margin-bottom: 0.75rem;
  }

  .timeline-highlights {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .timeline-highlights li {
    font-size: 0.88rem;
    color: var(--mute);
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.45;
  }

  .timeline-highlights li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }
</style>
