---
import { PROFILE } from '../data/profile.js';
---

<section id="contact" class="contact-section">
  <div class="container">
    <div class="contact-box">
      <div class="contact-header">
        <span class="section-tag contact-tag">Get in Touch</span>
        <h2 class="contact-title">Let’s engineer something exceptional together.</h2>
        <p class="contact-lead">
          I’m actively looking for software engineering internships and junior roles. Whether you have an open opportunity, a design project, or just want to connect, send me a message.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Direct Channels -->
        <div class="channels-column">
          <h3 class="channels-heading">Direct Channels</h3>
          
          <div class="channel-cards">
            <a href={`mailto:${PROFILE.email}`} class="channel-card">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="channel-info">
                <span class="channel-type">Email</span>
                <span class="channel-value">{PROFILE.email}</span>
              </div>
              <svg class="external-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17l9.2-9.2M17 17V8H8"></path>
              </svg>
            </a>

            <a href={`tel:${PROFILE.phone.replace(/\s+/g, '')}`} class="channel-card">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="channel-info">
                <span class="channel-type">Phone</span>
                <span class="channel-value">{PROFILE.phoneFormatted}</span>
              </div>
              <svg class="external-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17l9.2-9.2M17 17V8H8"></path>
              </svg>
            </a>

            <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="channel-card">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </div>
              <div class="channel-info">
                <span class="channel-type">LinkedIn</span>
                <span class="channel-value">{PROFILE.linkedinHandle}</span>
              </div>
              <svg class="external-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17l9.2-9.2M17 17V8H8"></path>
              </svg>
            </a>

            <a href={PROFILE.behance} target="_blank" rel="noopener noreferrer" class="channel-card">
              <div class="channel-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22 7h-7v-2h7v2zm1.726 10c-.442 1.297-2.029 3-4.726 3-3.111 0-5.127-2.146-5.127-5.46 0-3.212 2.016-5.54 4.965-5.54 3.02 0 4.888 2.222 4.888 5.485v.815h-7.607c.074 1.705 1.341 2.875 3.033 2.875 1.277 0 2.235-.589 2.574-1.175zm-4.764-5.32c-1.398 0-2.348.972-2.52 2.392h5.059c-.068-1.428-.992-2.392-2.539-2.392zm-12.962 8.32h-6v-16h6.297c2.316 0 4.103.543 4.103 2.857 0 1.378-.854 2.238-1.928 2.668 1.488.455 2.528 1.482 2.528 3.324 0 2.502-1.984 3.151-5 3.151zm-3.5-13.5v4.5h2.8c1.3 0 2.2-.4 2.2-1.8 0-1.3-.9-1.7-2.2-1.7h-2.8zm0 7v4.5h3.2c1.4 0 2.4-.4 2.4-1.9 0-1.4-1-1.6-2.4-1.6h-3.2z"/>
                </svg>
              </div>
              <div class="channel-info">
                <span class="channel-type">Behance</span>
                <span class="channel-value">{PROFILE.behanceHandle}</span>
              </div>
              <svg class="external-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17l9.2-9.2M17 17V8H8"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="form-column">
          <h3 class="channels-heading">Send a Quick Message</h3>
          <form id="contact-form" class="styled-form">
            <div class="form-row">
              <div class="form-group">
                <label for="contact-name">Your Name</label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  placeholder="e.g. Alex Dupont" 
                  required 
                />
              </div>
              <div class="form-group">
                <label for="contact-email">Your Email</label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  placeholder="e.g. alex@company.com" 
                  required 
                />
              </div>
            </div>

            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input 
                type="text" 
                id="contact-subject" 
                name="subject" 
                placeholder="Internship opportunity / Freelance inquiry" 
                required 
              />
            </div>

            <div class="form-group">
              <label for="contact-message">Message</label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="4" 
                placeholder="Tell me about your team or project..." 
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary form-submit-btn">
              <span>Send Message</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
            <p id="form-feedback" class="form-status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value;
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value;
      const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value;
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value;

      const mailtoUrl = `mailto:mh8180038@gmail.com?subject=${encodeURIComponent(
        subject ? `${subject} - via Portfolio (${name})` : `Message from ${name}`
      )}&body=${encodeURIComponent(`${message}\n\nFrom: ${name} (${email})`)}`;

      window.location.href = mailtoUrl;

      if (feedback) {
        feedback.textContent = "Opening your email client to send message...";
        feedback.style.color = "var(--accent)";
      }
    });
  }
</script>

<style>
  .contact-section {
    padding-bottom: 6rem;
  }

  .contact-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    padding: 3.5rem 3rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 768px) {
    .contact-box {
      padding: 2.5rem 1.5rem;
    }
  }

  .contact-header {
    max-width: 680px;
    margin-bottom: 3rem;
  }

  .contact-title {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .contact-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--mute);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .channels-heading {
    font-size: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .channel-cards {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-spring);
  }

  .channel-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: var(--soft);
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
  }

  .channel-type {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--mute);
    letter-spacing: 0.05em;
  }

  .channel-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .external-arrow {
    color: var(--mute);
    transition: transform var(--duration-fast);
  }

  .channel-card:hover .external-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* Form Styles */
  .styled-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 550px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.8rem 1rem;
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .form-submit-btn {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .form-status {
    font-size: 0.88rem;
    margin-top: 0.25rem;
  }
</style>
