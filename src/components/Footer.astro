---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-left">
      <span class="footer-logo">mohamed<span class="logo-accent">.</span>hamdi</span>
      <p class="footer-text">&copy; {currentYear} Mohamed Hamdi. Crafted with component architecture in Astro.</p>
    </div>

    <div class="footer-right">
      <a href="#hero" class="back-to-top" aria-label="Back to top">
        <span>Back to top</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding: 2.5rem 0;
    transition: background-color var(--duration-normal), border-color var(--duration-normal);
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .logo-accent {
    color: var(--accent);
  }

  .footer-text {
    font-size: 0.88rem;
    color: var(--mute);
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--mute);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    transition: all var(--duration-fast);
  }

  .back-to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
</style>
