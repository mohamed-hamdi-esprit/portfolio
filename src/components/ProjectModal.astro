---
---

<dialog id="project-modal" class="project-modal" aria-labelledby="modal-title">
  <div class="modal-surface">
    <button id="modal-close-btn" class="modal-close-trigger" aria-label="Close project modal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-media">
      <img id="modal-img" src="/images/desktop-app.jpg" alt="" class="modal-image-preview" />
    </div>

    <div class="modal-content">
      <div class="modal-header">
        <span id="modal-category" class="modal-category-badge">Software Engineering</span>
        <h3 id="modal-title" class="modal-title">Project Title</h3>
      </div>

      <p id="modal-desc" class="modal-description"></p>

      <div id="modal-features" class="modal-features-section"></div>

      <div class="modal-tags-wrapper">
        <span class="tags-label">Technologies & Tools:</span>
        <div id="modal-tags" class="modal-tags-list"></div>
      </div>

      <div class="modal-actions">
        <a id="modal-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <span>View Project</span>
        </a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .project-modal {
    border: none;
    border-radius: var(--radius-xl);
    padding: 0;
    max-width: 720px;
    width: calc(100% - 2rem);
    background: transparent;
    color: var(--ink);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    margin: auto;
  }

  .project-modal::backdrop {
    background: rgba(8, 12, 22, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .modal-surface {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: relative;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
  }

  .modal-close-trigger {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: rgba(15, 23, 42, 0.7);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    transition: background var(--duration-fast);
  }

  .modal-close-trigger:hover {
    background: rgba(15, 23, 42, 0.95);
  }

  .modal-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--surface-alt);
    flex-shrink: 0;
  }

  .modal-image-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-content {
    padding: 2rem 2.25rem 2.25rem;
    overflow-y: auto;
  }

  .modal-category-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    display: block;
    margin-bottom: 0.4rem;
  }

  .modal-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .modal-description {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--mute);
    margin-bottom: 1.5rem;
  }

  :global(.modal-features-section) {
    background: var(--surface-alt);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--line);
  }

  :global(.modal-features-section h4) {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--ink);
  }

  :global(.modal-features-section ul) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.modal-features-section li) {
    font-size: 0.9rem;
    color: var(--mute);
    position: relative;
    padding-left: 1.2rem;
  }

  :global(.modal-features-section li::before) {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }

  .modal-tags-wrapper {
    margin-bottom: 2rem;
  }

  .tags-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--mute);
    margin-bottom: 0.5rem;
  }

  :global(#modal-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  :global(#modal-tags .badge) {
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--soft);
    color: var(--ink);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .modal-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
</style>
