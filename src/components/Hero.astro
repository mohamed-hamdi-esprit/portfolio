---
import { PROFILE } from '../data/profile.js';
---

<section id="hero" class="hero-section">
  <!-- Dynamic Ambient Glow that morphs with persona -->
  <div id="hero-glow" class="hero-ambient-glow" aria-hidden="true"></div>

  <!-- Background Rising Particles Layer -->
  <div id="hero-particles" class="hero-particles-layer" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-grid">
      <!-- LEFT COLUMN: Identity, Persona Toggle, CTAs -->
      <div class="hero-col-info">
        <!-- Persona Perspective Switcher -->
        <div class="persona-switch-wrapper">
          <span class="persona-label">Perspective:</span>
          <div class="persona-switch" role="group" aria-label="Toggle portfolio focus perspective">
            <button id="mode-dev" class="persona-btn" aria-pressed="true" data-mode-target="dev">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              <span>Developer</span>
            </button>
            <button id="mode-des" class="persona-btn" aria-pressed="false" data-mode-target="des">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                <path d="M2 2l7.586 7.586"></path>
                <circle cx="11" cy="11" r="2"></circle>
              </svg>
              <span>Designer</span>
            </button>
          </div>
        </div>

        <!-- Main Headline -->
        <div class="hero-content">
          <div class="badge-status">
            <span class="status-pulse"></span>
            <span>Available for Internships & Junior Roles</span>
          </div>

          <h1 class="hero-title">
            Mohamed<br />
            <span class="hero-surname">Hamdi</span>
          </h1>

          <div class="hero-role-wrapper">
            <span class="role-prefix">Focus &rsaquo;</span>
            <div id="typewriter-role" class="typewriter-role" aria-live="polite">
              Software Engineering Student
            </div>
          </div>

          <p id="hero-lead" class="lead hero-lead">
            {PROFILE.modes.dev.lead}
          </p>

          <!-- Action CTAs -->
          <div class="hero-actions">
            <a href="#work" class="btn btn-primary">
              <span>Explore Selected Work</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M7 17l9.2-9.2M17 17V8H8"></path>
              </svg>
            </a>
            <a href="#contact" class="btn btn-outline">
              <span>Get in Touch</span>
            </a>
            <a href="https://github.com/mohamed-hamdi-esprit" target="_blank" rel="noopener noreferrer" class="btn btn-sm social-pill" aria-label="GitHub Profile">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </div>

          <!-- Quick Facts -->
          <ul class="quick-facts">
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
              <span>Software Engineering Student at ESPRIT</span>
            </li>
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Freelance E-Commerce (2025 – Present) &bull; Design (2023 – 2025)</span>
            </li>
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Ariana, Tunisia</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- RIGHT COLUMN: 3D Interactive Laptop Stage & Floating Physics Tokens -->
      <div class="hero-col-stage">
        <div id="stage-viewport" class="stage-viewport">
          <!-- Floating Physics Badges Layer (Repelled by Cursor + Implode/Explode) -->
          <div id="tokens-layer" class="tokens-layer" aria-hidden="true">
            <!-- Badges dynamically injected / bound with physics -->
          </div>

          <!-- 3D Laptop Interactive Rig -->
          <div id="laptop-rig" class="laptop-rig" role="button" tabindex="0" aria-label="Toggle between Developer and Designer mode">
            <!-- Ambient Stage Shadow -->
            <div class="laptop-floor-shadow"></div>

            <!-- 3D Transform Anchor for Cursor Tilt & 720deg Spin -->
            <div id="laptop-mesh" class="laptop-mesh">
              <!-- BASE (Bottom Keyboard Chassis) -->
              <div class="laptop-base">
                <div class="base-surface">
                  <!-- Keyboard Grid -->
                  <div class="keyboard-deck">
                    <div class="key-row"><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span></div>
                    <div class="key-row"><span class="k-key k-tab"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key k-ret"></span></div>
                    <div class="key-row"><span class="k-key k-caps"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key k-enter"></span></div>
                    <div class="key-row"><span class="k-key k-shift"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key k-shift"></span></div>
                    <div class="key-row"><span class="k-key"></span><span class="k-key"></span><span class="k-key"></span><span class="k-key k-space"></span><span class="k-key"></span><span class="k-key"></span></div>
                  </div>
                  <!-- Glass Trackpad -->
                  <div class="trackpad"></div>
                </div>
                <!-- Front Edge Notch & Metal Lip -->
                <div class="base-lip">
                  <span class="lip-notch"></span>
                </div>
              </div>

              <!-- DISPLAY LID (Screen Chassis angled backward) -->
              <div class="laptop-lid">
                <div class="lid-bezel">
                  <!-- Webcam & Sensor Dot -->
                  <div class="lid-camera">
                    <span class="camera-lens"></span>
                  </div>

                  <!-- ACTIVE SCREEN (Hot-swaps between IDE and Adobe Photoshop/Illustrator) -->
                  <div class="laptop-screen-display">
                    <!-- 1. DEVELOPER SCREEN: VS Code / IntelliJ IDE Interface -->
                    <div id="screen-dev" class="screen-view screen-dev active">
                      <div class="ide-titlebar">
                        <div class="traffic-dots">
                          <span class="dot dot-red"></span>
                          <span class="dot dot-yellow"></span>
                          <span class="dot dot-green"></span>
                        </div>
                        <div class="ide-tabs">
                          <div class="ide-tab active">
                            <svg class="tab-icon dev-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                            <span>PortfolioEngine.java</span>
                          </div>
                          <div class="ide-tab">
                            <svg class="tab-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span>telemetry.py</span>
                          </div>
                        </div>
                        <div class="ide-env-tag">SPRING BOOT · 3.2</div>
                      </div>

                      <div class="ide-body">
                        <div class="ide-sidebar">
                          <div class="side-icon active"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg></div>
                          <div class="side-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></div>
                          <div class="side-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg></div>
                        </div>

                        <div class="ide-code-pane">
                          <div class="code-lines">
                            <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>10</span>
                          </div>
                          <pre class="code-content"><code><span class="c-anno">@SpringBootApplication</span>
<span class="c-kw">public class</span> <span class="c-cls">MohamedHamdi</span> &#123;
  <span class="c-anno">@Autowired</span> <span class="c-kw">private</span> Observability <span class="c-var">telemetry</span>;

  <span class="c-kw">public static void</span> <span class="c-fn">main</span>(String[] args) &#123;
    SpringApplication.<span class="c-fn">run</span>(MohamedHamdi.<span class="c-kw">class</span>);
    <span class="c-str">"Status: Engineering Ready"</span>;
  &#125;
&#125;</code></pre>
                        </div>
                      </div>

                      <div class="ide-terminal">
                        <div class="term-prompt">
                          <span class="term-user">hamdi@esprit:~$</span>
                          <span class="term-cmd">mvn clean compile && run-telemetry</span>
                        </div>
                        <div class="term-status">
                          <span class="term-dot"></span>
                          <span>BUILD SUCCESS · Graylog Port: 8080 · 0 Errors</span>
                        </div>
                      </div>
                    </div>

                    <!-- 2. DESIGNER SCREEN: Adobe Photoshop & Illustrator Interface -->
                    <div id="screen-des" class="screen-view screen-des">
                      <div class="adobe-titlebar">
                        <div class="adobe-app-badge">Ps / Ai</div>
                        <div class="adobe-menu">
                          <span>File</span><span>Edit</span><span>Object</span><span>Layer</span><span>Type</span><span>Select</span><span>Filter</span><span>View</span>
                        </div>
                        <div class="adobe-zoom-tag">100% (RGB/8)</div>
                      </div>

                      <div class="adobe-body">
                        <!-- Left Adobe Tool Palette -->
                        <div class="adobe-toolbar">
                          <div class="tool-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 3l7 18 3-7 7-3L3 3z"></path></svg></div>
                          <div class="tool-btn active-pen"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path></svg></div>
                          <div class="tool-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v8M8 12h8"></path></svg></div>
                          <div class="tool-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 11l-8-8-8 8m16 0l-8 8-8-8"></path></svg></div>
                          <div class="tool-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="6"></circle></svg></div>
                        </div>

                        <!-- Center Canvas showing Real Graphic Work -->
                        <div class="adobe-canvas">
                          <div class="canvas-artboard">
                            <img src="/images/design/sissa-sissa-logo.jpg" alt="Sissa Sissa Brand Identity Artwork" class="artboard-artwork" />
                            <!-- Vector Selection & Bezier Handles Overlay -->
                            <div class="vector-selection-box">
                              <span class="handle h-tl"></span>
                              <span class="handle h-tr"></span>
                              <span class="handle h-bl"></span>
                              <span class="handle h-br"></span>
                              <span class="vector-anchor" style="top: 30%; left: 45%;"></span>
                              <span class="vector-anchor" style="top: 70%; left: 60%;"></span>
                              <svg class="bezier-guide-svg" viewBox="0 0 100 100">
                                <path d="M 25 35 Q 50 10 75 40 T 80 80" fill="none" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="3,3" />
                              </svg>
                            </div>
                          </div>
                        </div>

                        <!-- Right Adobe Layers & Swatches Panel -->
                        <div class="adobe-panels">
                          <div class="panel-section">
                            <div class="panel-header">LAYERS</div>
                            <div class="layer-item active"><span class="layer-eye">👁️</span><span>Logo_Vector.ai</span></div>
                            <div class="layer-item"><span class="layer-eye">👁️</span><span>Brand_Typography</span></div>
                            <div class="layer-item"><span class="layer-eye">👁️</span><span>Glow_Effect</span></div>
                          </div>
                          <div class="panel-section">
                            <div class="panel-header">SWATCHES</div>
                            <div class="swatches-grid">
                              <span class="swatch" style="background: #f43f5e;"></span>
                              <span class="swatch" style="background: #ec4899;"></span>
                              <span class="swatch" style="background: #8b5cf6;"></span>
                              <span class="swatch" style="background: #3b82f6;"></span>
                              <span class="swatch" style="background: #10b981;"></span>
                              <span class="swatch" style="background: #fbbf24;"></span>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="adobe-statusbar">
                        <span class="art-tag">Mohamed Hamdi · Visual Identity & Vector Systems</span>
                        <span class="art-coord">X: 1920px  Y: 1080px</span>
                      </div>
                    </div>

                    <!-- Screen Glass Glare Reflection -->
                    <div class="screen-glare" aria-hidden="true"></div>
                  </div>
                </div>

                <!-- Laptop Lid Hinge -->
                <div class="lid-hinge"></div>
              </div>
            </div>

            <!-- Stage Interaction Hint -->
            <div class="stage-hint">
              <span class="hint-pulse"></span>
              <span class="hint-text">Click laptop or switch to flip craft</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* -------------------------------------------------------------------------
     HERO SECTION BASE
     ------------------------------------------------------------------------- */
  .hero-section {
    position: relative;
    padding: 3.5rem 0 5rem;
    overflow: hidden;
    min-height: 86vh;
    display: flex;
    align-items: center;
  }

  /* Ambient Dynamic Glow that morphs on persona switch */
  .hero-ambient-glow {
    position: absolute;
    top: -100px;
    right: 15%;
    width: 750px;
    height: 520px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 68%);
    filter: blur(90px);
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
    transition: background 1.2s var(--ease-spring), opacity 0.5s ease;
  }

  .hero-particles-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .stage-particle {
    position: absolute;
    bottom: -30px;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  /* -------------------------------------------------------------------------
     LEFT COLUMN CONTENT
     ------------------------------------------------------------------------- */
  .hero-col-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .persona-switch-wrapper {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .persona-label {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
  }

  .persona-switch {
    display: inline-flex;
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-full);
    padding: 4px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .persona-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-full);
    padding: 0.5rem 1.2rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--mute);
    transition: all var(--duration-fast) var(--ease-spring);
  }

  .persona-btn:hover {
    color: var(--ink);
  }

  .persona-btn[aria-pressed="true"] {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: 0 2px 14px var(--accent-glow);
  }

  .badge-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-secondary);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .hero-title {
    margin-bottom: 0.75rem;
    font-size: clamp(3rem, 5.5vw, 4.75rem);
    line-height: 1.05;
  }

  .hero-surname {
    color: var(--ink);
    position: relative;
    display: inline-block;
  }

  .hero-role-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.25rem 0 1rem;
  }

  .role-prefix {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--mute);
  }

  .typewriter-role {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    font-weight: 700;
    color: var(--accent);
    min-height: 1.3em;
    letter-spacing: -0.02em;
    transition: color var(--duration-normal);
  }

  .hero-lead {
    max-width: 540px;
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .social-pill {
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 0.75rem 1.25rem;
    font-weight: 600;
  }

  .social-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .quick-facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
  }

  .quick-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
    color: var(--mute);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }

  .quick-facts li svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* -------------------------------------------------------------------------
     RIGHT COLUMN: 3D INTERACTIVE LAPTOP & TOKENS STAGE
     ------------------------------------------------------------------------- */
  .hero-col-stage {
    position: relative;
    width: 100%;
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1400px;
    -webkit-perspective: 1400px;
  }

  .stage-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* -------------------------------------------------------------------------
     FLOATING PHYSICS TOKENS (REPELLED BY CURSOR)
     ------------------------------------------------------------------------- */
  .tokens-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 20;
  }

  :global(.floating-token-badge) {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.85);
    border: 1.5px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink);
    cursor: default;
    pointer-events: auto;
