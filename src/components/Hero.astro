<script>
  import { gsap } from 'gsap';

  // ---------------------------------------------------------------------------
  // FLOATING BADGES CONFIGURATION (DEV & DES CRAFTS)
  // ---------------------------------------------------------------------------
  const TOKENS_DATA = [
    {
      id: 't1',
      top: 6,
      left: 8,
      duration: 5.5,
      dev: { name: 'Spring Boot', icon: '🍃', color: '#10b981' },
      des: { name: 'Photoshop', icon: 'Ps', color: '#38bdf8' }
    },
    {
      id: 't2',
      top: 10,
      left: 72,
      duration: 6.8,
      dev: { name: 'Angular', icon: '🅰️', color: '#ef4444' },
      des: { name: 'Illustrator', icon: 'Ai', color: '#f59e0b' }
    },
    {
      id: 't3',
      top: 42,
      left: -2,
      duration: 7.2,
      dev: { name: 'Java', icon: '☕', color: '#f97316' },
      des: { name: 'Pen Tool', icon: '✒️', color: '#ec4899' }
    },
    {
      id: 't4',
      top: 38,
      left: 80,
      duration: 6.0,
      dev: { name: 'Python', icon: '🐍', color: '#eab308' },
      des: { name: 'Premiere Pro', icon: 'Pr', color: '#9333ea' }
    },
    {
      id: 't5',
      top: 74,
      left: 10,
      duration: 8.0,
      dev: { name: 'Symfony', icon: '⚡', color: '#6366f1' },
      des: { name: 'After Effects', icon: 'Ae', color: '#8b5cf6' }
    },
    {
      id: 't6',
      top: 76,
      left: 70,
      duration: 6.5,
      dev: { name: 'Git & CI/CD', icon: '🐙', color: '#f43f5e' },
      des: { name: 'Color Palette', icon: '🎨', color: '#f43f5e' }
    },
    {
      id: 't7',
      top: 2,
      left: 42,
      duration: 9.0,
      dev: { name: 'Telemetry', icon: '📊', color: '#06b6d4' },
      des: { name: 'Typography', icon: 'Aa', color: '#fb7185' }
    },
    {
      id: 't8',
      top: 86,
      left: 40,
      duration: 7.5,
      dev: { name: 'MySQL', icon: '🐬', color: '#0284c7' },
      des: { name: 'Vector Mesh', icon: '📐', color: '#d946ef' }
    }
  ];

  // DOM Elements
  const stageViewport = document.getElementById('stage-viewport');
  const tokensLayer = document.getElementById('tokens-layer');
  const laptopRig = document.getElementById('laptop-rig');
  const laptopMesh = document.getElementById('laptop-mesh');
  const screenDev = document.getElementById('screen-dev');
  const screenDes = document.getElementById('screen-des');
  const heroGlow = document.getElementById('hero-glow');
  const heroParticles = document.getElementById('hero-particles');

  const modeDevBtn = document.getElementById('mode-dev');
  const modeDesBtn = document.getElementById('mode-des');

  let currentMode = 'dev';
  let isSpinningTransition = false;

  // Mouse State
  const mouse = { x: 0, y: 0, screenX: window.innerWidth / 2, screenY: window.innerHeight / 2 };
  const currentTilt = { x: 0, y: 0 };
  const spinRotY = { val: 0 };

  const tokenNodes = [];

  // ---------------------------------------------------------------------------
  // MOUNT FLOATING BADGES
  // ---------------------------------------------------------------------------
  function initTokens() {
    if (!tokensLayer) return;
    tokensLayer.innerHTML = '';

    TOKENS_DATA.forEach((data, index) => {
      const badge = document.createElement('div');
      badge.className = 'floating-token-badge';
      badge.id = `token-${data.id}`;
      badge.style.top = `${data.top}%`;
      badge.style.left = `${data.left}%`;

      const modeData = currentMode === 'dev' ? data.dev : data.des;
      badge.innerHTML = `
        <span class="token-icon" style="background: ${modeData.color}22; color: ${modeData.color};">${modeData.icon}</span>
        <span class="token-name">${modeData.name}</span>
      `;

      tokensLayer.appendChild(badge);

      tokenNodes.push({
        el: badge,
        config: data,
        repelX: 0,
        repelY: 0,
        floatY: 0,
        floatRot: 0,
        angle: Math.random() * 360,
        spinSpeed: 0.15
      });
    });
  }

  // ---------------------------------------------------------------------------
  // SPAWN RISING BACKGROUND PARTICLES
  // ---------------------------------------------------------------------------
  function spawnParticle() {
    if (!heroParticles) return;
    const p = document.createElement('div');
    p.className = 'stage-particle';

    const size = gsap.utils.random(4, 10);
    const startX = gsap.utils.random(5, 95);
    const duration = gsap.utils.random(5, 9);
    const color = currentMode === 'dev' 
      ? gsap.utils.random(['#38bdf8', '#34d399', '#818cf8']) 
      : gsap.utils.random(['#f43f5e', '#ec4899', '#c084fc']);

    p.style.width = `${size}px`;
    p.style.height = `${size}px`;
    p.style.left = `${startX}%`;
    p.style.background = color;
    p.style.boxShadow = `0 0 10px ${color}`;
    p.style.opacity = '0.35';

    heroParticles.appendChild(p);

    gsap.to(p, {
      y: '-90vh',
      x: gsap.utils.random(-30, 30),
      opacity: 0,
      duration: duration,
      ease: 'power1.out',
      onComplete: () => p.remove()
    });
  }

  // ---------------------------------------------------------------------------
  // CHOREOGRAPHED SODA-STYLE 720° TRANSITION
  // ---------------------------------------------------------------------------
  export function triggerModeTransition(targetMode) {
    if (isSpinningTransition || targetMode === currentMode) return;
    isSpinningTransition = true;

    // 1. Ambient Glow Morph
    if (heroGlow) {
      const glowColor = targetMode === 'des'
        ? 'radial-gradient(circle, rgba(244, 63, 94, 0.35) 0%, rgba(168, 85, 247, 0.15) 45%, transparent 70%)'
        : 'radial-gradient(circle, rgba(59, 130, 246, 0.32) 0%, rgba(16, 185, 129, 0.18) 45%, transparent 70%)';
      heroGlow.style.background = glowColor;
    }

    // 2. 720° Laptop Spin with Motion Blur (Exact Soda choreography)
    // Phase 1: 0 -> 360deg with blur 14px over 0.55s
    gsap.to(spinRotY, {
      val: spinRotY.val + 360,
      duration: 0.55,
      ease: 'power2.in'
    });

    if (laptopMesh) {
      gsap.to(laptopMesh, {
        filter: 'blur(14px) drop-shadow(0 35px 50px rgba(0,0,0,0.6))',
        duration: 0.55,
        ease: 'power2.in',
        onComplete: () => {
          // HOT-SWAP SCREEN at peak!
          if (targetMode === 'des') {
            screenDev?.classList.remove('active');
            screenDes?.classList.add('active');
          } else {
            screenDes?.classList.remove('active');
            screenDev?.classList.add('active');
          }

          // Phase 2: 360deg -> 720deg with back.out(0.7) and blur returning to 0px
          gsap.to(spinRotY, {
            val: spinRotY.val + 360,
            duration: 1.4,
            ease: 'back.out(0.7)'
          });

          gsap.to(laptopMesh, {
            filter: 'blur(0px) drop-shadow(0 35px 60px rgba(0,0,0,0.4))',
            duration: 1.4,
            ease: 'back.out(0.7)'
          });
        }
      });
    }

    // 3. Tokens Implode -> Icon/Label Swap -> Explode
    const badgeElements = tokenNodes.map(t => t.el);

    gsap.to(badgeElements, {
      scale: 0.1,
      opacity: 0,
      duration: 0.45,
      ease: 'power2.in',
      onComplete: () => {
        // Swap content while hidden
        tokenNodes.forEach(t => {
          const modeData = targetMode === 'dev' ? t.config.dev : t.config.des;
          t.el.innerHTML = `
            <span class="token-icon" style="background: ${modeData.color}22; color: ${modeData.color};">${modeData.icon}</span>
            <span class="token-name">${modeData.name}</span>
          `;
        });

        // Hold 0.25s then explode back out with spring bounce
        setTimeout(() => {
          tokenNodes.forEach(t => {
            const jitterX = gsap.utils.random(-40, 40);
            const jitterY = gsap.utils.random(-40, 40);

            gsap.fromTo(t.el,
              { x: jitterX, y: jitterY, scale: 0.1, opacity: 0 },
              {
                x: 0,
                y: 0,
                scale: 1,
                opacity: 1,
                duration: 0.85,
                ease: 'back.out(1.5)',
                onComplete: () => {
                  t.repelX = 0;
                  t.repelY = 0;
                }
              }
            );
          });

          currentMode = targetMode;
          isSpinningTransition = false;
        }, 250);
      }
    });
  }

  // ---------------------------------------------------------------------------
  // MOUSE TRACKING & CONTINUOUS PHYSICS RAF LOOP
  // ---------------------------------------------------------------------------
  window.addEventListener('mousemove', (e) => {
    mouse.screenX = e.clientX;
    mouse.screenY = e.clientY;

    if (stageViewport) {
      const rect = stageViewport.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      // Local normalized coordinates (-1 to 1)
      mouse.x = Math.max(-1, Math.min(1, (e.clientX - centerX) / (rect.width / 2)));
      mouse.y = Math.max(-1, Math.min(1, (e.clientY - centerY) / (rect.height / 2)));
    }
  });

  // Laptop direct click triggers toggle
  laptopRig?.addEventListener('click', () => {
    const nextMode = currentMode === 'dev' ? 'des' : 'dev';
    const targetBtn = nextMode === 'des' ? modeDesBtn : modeDevBtn;
    if (targetBtn) {
      targetBtn.click();
    } else {
      triggerModeTransition(nextMode);
    }
  });

  // Listen to persona switch button clicks
  modeDevBtn?.addEventListener('click', () => triggerModeTransition('dev'));
  modeDesBtn?.addEventListener('click', () => triggerModeTransition('des'));

  function physicsLoop(timestamp) {
    const elapsed = timestamp * 0.001;

    // 1. Mouse Lerp Interpolation
    currentTilt.x += (mouse.x - currentTilt.x) * 0.05;
    currentTilt.y += (mouse.y - currentTilt.y) * 0.05;

    // 2. Real-Time 3D Laptop Tilt + Spin
    // Base resting: rotateX(15deg) rotateY(-18deg) rotateZ(3deg)
    const tiltX = 15 - (currentTilt.y * 14);
    const tiltY = -18 + (currentTilt.x * 22) + spinRotY.val;
    const tiltZ = 3 + (currentTilt.x * 4);

    if (laptopMesh) {
      laptopMesh.style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg) rotateZ(${tiltZ}deg)`;
    }

    // 3. Floating Tokens Repulsion & Levitation Physics
    if (!isSpinningTransition) {
      tokenNodes.forEach((token) => {
        // Floating oscillation
        const floatPhase = elapsed * ((Math.PI * 2) / token.config.duration);
        token.floatY = Math.sin(floatPhase) * 12;
        token.floatRot = Math.cos(floatPhase * 0.8) * 5;

        // Pointer Repulsion calculation
        const rect = token.el.getBoundingClientRect();
        const badgeCenterX = rect.left + rect.width / 2;
        const badgeCenterY = rect.top + rect.height / 2;

        const diffX = mouse.screenX - badgeCenterX;
        const diffY = mouse.screenY - badgeCenterY;
        const dist = Math.hypot(diffX, diffY);
        const repelRadius = 320;

        let targetRepelX = 0;
        let targetRepelY = 0;
        let force = 0;

        if (dist < repelRadius && dist > 1) {
          force = 1 - (dist / repelRadius);
          const normX = diffX / dist;
          const normY = diffY / dist;
          targetRepelX = normX * (-75 * force);
          targetRepelY = normY * (-75 * force);
        }

        token.repelX += (targetRepelX - token.repelX) * 0.1;
        token.repelY += (targetRepelY - token.repelY) * 0.1;

        // Parallax factor
        const parallaxX = currentTilt.x * 35;
        const parallaxY = currentTilt.y * 35;

        token.el.style.transform = `translate(${token.repelX + parallaxX}px, ${token.floatY + token.repelY + parallaxY}px) rotate(${token.floatRot}deg)`;
      });
    }

    requestAnimationFrame(physicsLoop);
  }

  // ---------------------------------------------------------------------------
  // BOOTSTRAP HERO STAGE
  // ---------------------------------------------------------------------------
  initTokens();
  setInterval(spawnParticle, 450);
  requestAnimationFrame(physicsLoop);
</script>
